<Window x:Class="NuGetExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NuGetExplorer.ViewModels"
        Title="NuGet Explorer" Height="700" Width="1450" MinHeight="520" MinWidth="1000"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button Content="Load packages" Command="{Binding LoadPackagesCommand}" DockPanel.Dock="Right" Padding="16,6" Margin="10,0,0,0"/>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Padding="8" ToolTip="Search packages by ID or title"/>
        </DockPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Project file" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox Text="{Binding ProjectPath, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Padding="6" ToolTip="Optional path to a .csproj file"/>
        </DockPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
            <GroupBox Header="Available packages" Margin="0,0,7,0">
                <ListView ItemsSource="{Binding FilteredPackages}" SelectedItem="{Binding SelectedPackage}" BorderThickness="0">
                    <ListView.View><GridView>
                        <GridViewColumn Header="Package ID" DisplayMemberBinding="{Binding Id}" Width="210"/>
                        <GridViewColumn Header="Installed" DisplayMemberBinding="{Binding InstalledVersion}" Width="100"/>
                        <GridViewColumn Header="Latest" DisplayMemberBinding="{Binding LatestVersion}" Width="100"/>
                        <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="130"/>
                    </GridView></ListView.View>
                </ListView>
            </GroupBox>
            <GroupBox Grid.Column="1" Header="Package versions" Margin="7,0,7,0">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="{Binding SelectedPackage.Id}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SelectedPackage.Description}" TextWrapping="Wrap" Foreground="DimGray" Margin="0,4,0,0"/>
                    </StackPanel>
                    <ListView Grid.Row="1" ItemsSource="{Binding AvailableVersions}" BorderThickness="0">
                        <ListView.View><GridView>
                            <GridViewColumn Header="Version" DisplayMemberBinding="{Binding Version}" Width="180"/>
                            <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="120"/>
                            <GridViewColumn Header="Action" Width="105">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><Button Content="View Content" Command="{Binding DownloadCommand}" Padding="8,3"/></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView></ListView.View>
                    </ListView>
                </Grid>
            </GroupBox>
            <GroupBox Grid.Column="2" Header="Package contents" Margin="7,0,0,0">
                <TreeView ItemsSource="{Binding PackageContent}" BorderThickness="0" Margin="6">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type vm:PackageContentNode}" ItemsSource="{Binding Children}">
                            <Border Padding="3,2" CornerRadius="3">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" FontFamily="Segoe UI Emoji" FontSize="14" Margin="0,0,7,0"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </HierarchicalDataTemplate>
                    </TreeView.Resources>
                </TreeView>
            </GroupBox>
        </Grid>
        <StatusBar Grid.Row="3" Margin="0,8,0,0">
            <StatusBarItem Content="{Binding StatusMessage}"/><Separator/>
            <StatusBarItem><ProgressBar Width="90" Height="12" IsIndeterminate="{Binding IsBusy}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/></StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
